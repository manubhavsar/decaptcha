# ── World ID — Selfie Check (Beta) ───────────────────────────────────────────
# From your app at https://developer.world.org
#
# TWO SEPARATE APPROVALS ARE REQUIRED BEFORE THIS WILL RUN. Neither is
# self-serve and both say "wait for approval", so start them first:
#
#   1. Selfie Check (Beta) feature flag, enabled per app.
#      Request from developers@toolsforhumanity.com, or your World contact.
#      At a hackathon, the sponsor rep in Discord is the fast path.
#   2. Sandbox app tester access, requested in the Developer Portal under
#      "World ID Sandbox". iOS is TestFlight; Android is a private Play track
#      keyed to one Google account.
#
WORLD_APP_ID=
WORLD_RP_ID=
# Server-side only. Never ship this to the extension or commit it.
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=vouch-for-my-agent
# production | staging | sandbox. Sandbox proofs still verify against the
# production verify endpoint.
WORLD_ENVIRONMENT=sandbox

# Build aid ONLY, so the ENS work in steps 3-6 is not blocked behind the two
# approvals above. Produces credentials marked "simulated" that say so in the
# UI, the gate log and the on-chain record. MUST be unset for the demo.
# WORLD_DEV_BYPASS=1


# ── ENS v2 on Sepolia ────────────────────────────────────────────────────────
# A Sepolia RPC URL (Alchemy, Infura, or any public endpoint).
SEPOLIA_RPC_URL=
# Burner key only. Never a wallet holding anything real.
DEPLOYER_PRIVATE_KEY=
# The parent name vouches are minted under, e.g. decaptcha.eth
ENS_PARENT_NAME=
